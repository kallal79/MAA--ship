+    b: 2,
+  });
+  expect(z.map(z.string(), z.number().default(1, { skipEncoding: true })).encode(new Map([["a", 1]]))).toEqual(
+    new Map()
+  );
+  expect(z.map(defaultString, z.number()).encode(new Map([["x", 1]]))).toEqual(new Map());
+  expect(z.array(defaultString).encode(["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.tuple([z.string(), defaultString, z.string()]).encode(["a", "x", "b"])).toEqual(["a", "b"]);
