+import { expect, test } from "vitest";
+import { z } from "../../../index.js";
+
+// 1. encode skips default values in objects
+test("encode skips default values in objects", () => {
+  const schema = z.object({
+    a: z.number().default(0, { skipEncoding: true }),
+    b: z.string().default("hello", { skipEncoding: true }),
+  });
+  expect(schema.encode({ a: 0, b: "hello" })).toEqual({});
+  expect(schema.encode({ a: 1, b: "hello" })).toEqual({ a: 1 });
+  expect(schema.encode({ a: 0, b: "world" })).toEqual({ b: "world" });
+  expect(schema.encode({ a: 1, b: "world" })).toEqual({ a: 1, b: "world" });
+});
+
+// 2. encode skips default values in records
+test("encode skips default values in records", () => {
+  const schema = z.record(z.string(), z.number().default(0, { skipEncoding: true }));
+  expect(schema.encode({ x: 0, y: 1 })).toEqual({ y: 1 });
+  expect(schema.encode({ x: 0, y: 0 })).toEqual({});
+
+  // Record with key default omission
+  const keySchema = z.record(z.string().default("defKey", { skipEncoding: true }), z.number());
+  expect(keySchema.encode({ defKey: 100, otherKey: 200 })).toEqual({ otherKey: 200 });
+});
+
+// 3. encode skips default values in maps
+test("encode skips default values in maps", () => {
+  const schema = z.map(z.string(), z.number().default(0, { skipEncoding: true }));
+  const m1 = new Map([["a", 0], ["b", 1]]);
+  const result = schema.encode(m1);
+  expect(result).toEqual(new Map([["b", 1]]));
+});
+
+// 3b. Map key-default-triggered omission
+test("Map key-default-triggered omission", () => {
+  const schema = z.map(
+    z.string().default("omitKey", { skipEncoding: true }),
+    z.number()
+  );
+  expect(schema.encode(new Map([["omitKey", 1], ["keepKey", 2]]))).toEqual(
+    new Map([["keepKey", 2]])
+  );
+});
+
+// 4. encode skips default values in arrays
+test("encode skips default values in arrays", () => {
+  const schema = z.array(z.number().default(0, { skipEncoding: true }));
+  expect(schema.encode([0, 1, 0, 2])).toEqual([1, 2]);
+});
+
+// 5. encode skips default values in tuples
+test("encode skips default values in tuples", () => {
+  const schema = z.tuple([
+    z.number().default(0, { skipEncoding: true }),
+    z.string(),
+  ]);
+  expect(schema.encode([0, "a"])).toEqual(["a"]);
+  expect(schema.encode([1, "a"])).toEqual([1, "a"]);
+});
+
+// 6. encode skips multiple default values in tuples
+test("encode skips multiple default values in tuples", () => {
+  const schema = z.tuple([
+    z.number().default(0, { skipEncoding: true }),
+    z.string().default("x", { skipEncoding: true }),
+    z.boolean().default(false, { skipEncoding: true }),
+  ]);
+  expect(schema.encode([0, "x", false])).toEqual([]);
+  expect(schema.encode([1, "x", false])).toEqual([1]);
+  expect(schema.encode([0, "y", false])).toEqual(["y"]);
+});
+
+// 7. encode skips default values in sets
+test("encode skips default values in sets", () => {
+  const schema = z.set(z.number().default(0, { skipEncoding: true }));
+  const s = new Set([0, 1, 2]);
+  const result = schema.encode(s);
+  expect(result).toEqual(new Set([1, 2]));
+});
+
+// 8. encode skips default values with deep equality
+test("encode skips default values with deep equality", () => {
+  const schema = z.object({
+    o: z.object({ x: z.number() }).default({ x: 1 }, { skipEncoding: true }),
+  });
+  expect(schema.encode({ o: { x: 1 } })).toEqual({});
+  expect(schema.encode({ o: { x: 2 } })).toEqual({ o: { x: 2 } });
+
+  // Date deep equality
+  const d = new Date(1000);
+  const schema2 = z.object({
+    d: z.date().default(new Date(1000), { skipEncoding: true }),
+  });
+  expect(schema2.encode({ d: new Date(1000) })).toEqual({});
+  expect(schema2.encode({ d: new Date(2000) })).toEqual({ d: new Date(2000) });
+
+  // Set with Date deep equality order-independent
+  const d1 = new Date(1000);
+  const d2 = new Date(2000);
+  const schema3 = z.object({
+    s: z.set(z.date()).default(new Set([d1, d2]), { skipEncoding: true }),
+  });
+  expect(schema3.encode({ s: new Set([new Date(2000), new Date(1000)]) })).toEqual({});
+  expect(schema3.encode({ s: new Set([new Date(2000), new Date(3000)]) })).toEqual({
+    s: new Set([new Date(2000), new Date(3000)]),
+  });
+});
+
+// 9. async support
+test("async support", async () => {
+  const schema = z.object({
+    a: z.number().default(0, { skipEncoding: async (v) => v === 0 }),
+  });
+  expect(await schema.encodeAsync({ a: 0 })).toEqual({});
+  expect(await schema.encodeAsync({ a: 1 })).toEqual({ a: 1 });
+});
+
+// 10. nested defaults
+test("nested defaults", () => {
+  const inner = z.object({ x: z.number() }).default({ x: 0 }, { skipEncoding: true });
+  const outer = z.object({ inner }).default({ inner: { x: 0 } }, { skipEncoding: true });
+  const schema = z.object({ outer });
+  expect(schema.encode({ outer: { inner: { x: 0 } } })).toEqual({});
+  expect(schema.encode({ outer: { inner: { x: 1 } } })).toEqual({ outer: { inner: { x: 1 } } });
+});
+
+// 11. mini API exhaustive
+test("mini API exhaustive", () => {
+  const s1 = z.object({ n: z.number().default(0, { skipEncoding: true }) });
+  expect(s1.encode({ n: 0 })).toEqual({});
+  expect(s1.encode({ n: 1 })).toEqual({ n: 1 });
+
+  const s2 = z.string().default("x", { skipEncoding: true });
+  const obj2 = z.object({ v: s2 });
+  expect(obj2.encode({ v: "x" })).toEqual({});
+  expect(obj2.encode({ v: "y" })).toEqual({ v: "y" });
+
+  const s3 = z.boolean().default(false, { skipEncoding: true });
+  const obj3 = z.object({ flag: s3 });
+  expect(obj3.encode({ flag: false })).toEqual({});
+  expect(obj3.encode({ flag: true })).toEqual({ flag: true });
+});
+
+// 12. factory defaults
+test("factory defaults", () => {
+  const schema = z.object({
+    arr: z.array(z.number()).default(() => [], { skipEncoding: (v) => v.length === 0 }),
+  });
+  expect(schema.encode({ arr: [] })).toEqual({});
+  expect(schema.encode({ arr: [1] })).toEqual({ arr: [1] });
+});
+
+// 13. strict equality mode
+test("strict equality mode", () => {
+  const schema = z.object({
+    n: z.number().default(0, { skipEncoding: { mode: "strict" } }),
+  });
+  expect(schema.encode({ n: 0 })).toEqual({});
+  expect(schema.encode({ n: -0 })).toEqual({ n: -0 });
+  expect(schema.encode({ n: 1 })).toEqual({ n: 1 });
+
+  const sNaN = z.object({
+    x: z.any().default(NaN, { skipEncoding: { mode: "strict" } }),
+  });
+  expect(sNaN.encode({ x: NaN })).toEqual({});
+  expect(sNaN.encode({ x: 0 })).toEqual({ x: 0 });
+});
+
+// 14. shallow equality mode
+test("shallow equality mode", () => {
+  const obj = { x: 1 };
+  const schema = z.object({
+    o: z.object({ x: z.number() }).default(obj, { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(schema.encode({ o: obj })).toEqual({});
+  expect(schema.encode({ o: { x: 1 } })).toEqual({});
+  expect(schema.encode({ o: { x: 2 } })).toEqual({ o: { x: 2 } });
+});
+
+// 15. shallow equality mode - Set
+test("shallow equality mode - Set", () => {
+  const s = new Set([1, 2]);
+  const schema = z.object({
+    s: z.set(z.number()).default(s, { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(schema.encode({ s })).toEqual({});
+  expect(schema.encode({ s: new Set([1, 2]) })).toEqual({});
+  expect(schema.encode({ s: new Set([1, 3]) })).not.toEqual({});
+});
+
+// 15b. shallow equality mode - Map
+test("shallow equality mode - Map", () => {
+  const k1 = { id: 1 };
+  const v1 = { val: "a" };
+  const k2 = { id: 2 };
+  const v2 = { val: "b" };
+  const m = new Map([[k1, v1], [k2, v2]]);
+  const schema = z.object({
+    m: z.map(z.object({ id: z.number() }), z.object({ val: z.string() })).default(m, { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(schema.encode({ m: new Map([[k1, v1], [k2, v2]]) })).toEqual({});
+  expect(schema.encode({ m: new Map([[{ id: 1 }, { val: "a" }], [{ id: 2 }, { val: "b" }]]) })).not.toEqual({});
+});
+
+// 16. deep equality behaves identically to skipEncoding: true
+test("deep equality behaves identically to skipEncoding: true", () => {
+  const schema1 = z.object({
+    a: z.number().default(0, { skipEncoding: { mode: "deep" } }),
+  });
+  const schema2 = z.object({
+    a: z.number().default(0, { skipEncoding: true }),
+  });
+  expect(schema1.encode({ a: 0 })).toEqual({});
+  expect(schema2.encode({ a: 0 })).toEqual({});
+  expect(schema1.encode({ a: 1 })).toEqual({ a: 1 });
+  expect(schema2.encode({ a: 1 })).toEqual({ a: 1 });
+});
+
+// 17. nested defaults skip independently
+test("nested defaults skip independently", () => {
+  const inner = z.number().default(0, { skipEncoding: true });
+  const schema = z.object({
+    x: inner.default(1, { skipEncoding: true }),
+  });
+  expect(schema.encode({ x: 1 })).toEqual({});
+  expect(schema.encode({ x: 2 })).toEqual({ x: 2 });
+});
+
+// 18. predicate functions
+test("predicate functions", () => {
+  const schema = z.object({
+    a: z.number().default(0, { skipEncoding: (v) => v === 0 }),
+    b: z.number().default(10, { skipEncoding: (v) => v > 5 }),
+  });
+  expect(schema.encode({ a: 0, b: 6 })).toEqual({});
+  expect(schema.encode({ a: 1, b: 3 })).toEqual({ a: 1, b: 3 });
+});
+
+// 18b. predicate receives rawDefaultValue parameter
+test("predicate receives rawDefaultValue parameter", () => {
+  const received: any[] = [];
+  const schema = z.object({
+    a: z.string().default("fallback", {
+      skipEncoding: (val, raw) => {
+        received.push({ val, raw });
+        return val === "fallback";
+      },
+    }),
+  });
+  expect(schema.encode({ a: "fallback" })).toEqual({});
+  expect(received.length).toBeGreaterThan(0);
+});
+
+// 19. sync encode with async predicate throws error
+test("sync encode with async predicate throws error", () => {
+  const schema = z.object({
+    a: z.number().default(0, { skipEncoding: async (v) => v === 0 }),
+  });
+  expect(() => schema.encode({ a: 0 })).toThrowError(/Cannot use async skipEncoding in synchronous encode/);
+});
+
+// 20. factory default with skipEncoding true throws error
+test("factory default with skipEncoding true throws error", () => {
+  const schema = z.object({
+    a: z.number().default(() => 0, { skipEncoding: true }),
+  });
+  expect(() => schema.encode({ a: 0 })).toThrowError(/Cannot use skipEncoding: true with a factory default/);
+});
+
+// 21. factory default with skipEncoding mode object throws error
+test("factory default with skipEncoding mode object throws error", () => {
+  const schema = z.object({
+    a: z.number().default(() => 0, { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(() => schema.encode({ a: 0 })).toThrowError(/Cannot use skipEncoding: \{"mode":"shallow"\} with a factory default/);
+});
+
+// 22. wrapper transparency
+test("wrapper transparency", () => {
+  const schema = z.object({
+    opt: z.number().default(0, { skipEncoding: true }).optional(),
+    nul: z.number().default(0, { skipEncoding: true }).nullable(),
+  });
+  expect(schema.encode({ opt: 0, nul: 0 })).toEqual({});
+  expect(schema.encode({ opt: 1, nul: 2 })).toEqual({ opt: 1, nul: 2 });
+});
+
+// 22b. nullish wrapper transparency
+test("nullish wrapper transparency", () => {
+  const schema = z.object({
+    a: z.string().default("def", { skipEncoding: true }).nullish(),
+  });
+  expect(schema.encode({ a: "def" })).toEqual({});
+  expect(schema.encode({ a: "custom" })).toEqual({ a: "custom" });
+  expect(schema.encode({ a: null })).toEqual({ a: null });
+});
+
+// 23. container-level defaults
+test("container-level defaults", () => {
+  const defaultSet = new Set([1, 2]);
+  const defaultMap = new Map([["a", 1], ["b", 2]]);
+  const schema = z.object({
+    arr: z.array(z.number()).default([1, 2], { skipEncoding: true }),
+    rec: z.record(z.string(), z.number()).default({ a: 1 }, { skipEncoding: true }),
+    s: z.set(z.number()).default(defaultSet, { skipEncoding: true }),
+    m: z.map(z.string(), z.number()).default(defaultMap, { skipEncoding: true }),
+  });
+  expect(schema.encode({ arr: [1, 2], rec: { a: 1 }, s: new Set([2, 1]), m: new Map([["b", 2], ["a", 1]]) })).toEqual({});
+  expect(schema.encode({ arr: [1, 3], rec: { a: 2 }, s: new Set([1, 3]), m: new Map([["a", 1], ["b", 3]]) })).toEqual({
+    arr: [1, 3],
+    rec: { a: 2 },
+    s: new Set([1, 3]),
+    m: new Map([["a", 1], ["b", 3]]),
+  });
+});
+
+// 24. skipEncoding: false does not skip
+test("skipEncoding: false does not skip", () => {
+  const schema = z.object({
+    a: z.number().default(0, { skipEncoding: false }),
+  });
+  expect(schema.encode({ a: 0 })).toEqual({ a: 0 });
+});
+
+// 25. root-level encode
+test("root-level encode", () => {
+  const schema = z.number().default(0, { skipEncoding: true });
+  expect(z.encode(schema, 0)).toBe(0);
+  expect(z.encode(schema, 1)).toBe(1);
+});
+
+// 26. Set deep equality requires 1-to-1 bipartite matching
+test("Set deep equality requires 1-to-1 bipartite matching", () => {
+  const schema = z.object({
+    s: z.set(z.object({ a: z.number() })).default(new Set([{ a: 1 }, { a: 2 }]), { skipEncoding: true }),
+  });
+  expect(schema.encode({ s: new Set([{ a: 1 }, { a: 2 }]) })).toEqual({});
+  expect(schema.encode({ s: new Set([{ a: 1 }, { a: 1 }]) })).not.toEqual({});
+});
+
+// 27. tuple middle element removal
+test("tuple middle element removal", () => {
+  const schema = z.tuple([
+    z.string(),
+    z.number().default(0, { skipEncoding: true }),
+    z.boolean(),
+  ]);
+  expect(schema.encode(["a", 0, true])).toEqual(["a", true]);
+  expect(schema.encode(["a", 1, true])).toEqual(["a", 1, true]);
+});
+
+// 28. deep equality ignores non-enumerable properties
+test("deep equality ignores non-enumerable properties", () => {
+  const defaultObj: any = { a: 1 };
+  Object.defineProperty(defaultObj, "secret", {
+    value: "hidden",
+    enumerable: false,
+    configurable: true,
+  });
+
+  const schema = z.object({
+    obj: z.object({ a: z.number() }).default(defaultObj, { skipEncoding: true }),
+  });
+
+  expect(schema.encode({ obj: { a: 1 } })).toEqual({});
+});
+
+// 29. sparse array with undefined
+test("sparse array with undefined", () => {
+  const schema = z.object({
+    arr: z.array(z.any()).default([1, undefined, 3], { skipEncoding: true }),
+  });
+  const sparse = [1];
+  sparse[2] = 3;
+  expect(schema.encode({ arr: sparse })).toEqual({});
+});
+
+// 30. deep equality with nested maps
+test("deep equality with nested maps", () => {
+  const map1 = new Map([["key1", new Map([["nested", 42]])]]);
+  const schema = z.object({
+    m: z.map(z.string(), z.map(z.string(), z.number())).default(map1, { skipEncoding: true }),
+  });
+  const map2 = new Map([["key1", new Map([["nested", 42]])]]);
+  expect(schema.encode({ m: map2 })).toEqual({});
+});
+
+// 31. deep equality with nested sets
+test("deep equality with nested sets", () => {
+  const set1 = new Set([new Set(["a", "b"])]);
+  const schema = z.object({
+    s: z.set(z.set(z.string())).default(set1, { skipEncoding: true }),
+  });
+  const set2 = new Set([new Set(["b", "a"])]);
+  expect(schema.encode({ s: set2 })).toEqual({});
+});
+
+// 32. strict mode with symbols
+test("strict mode with symbols", () => {
+  const sym1 = Symbol("a");
+  const sym2 = Symbol("a");
+  const schema = z.object({
+    s: z.any().default(sym1, { skipEncoding: { mode: "strict" } }),
+  });
+  expect(schema.encode({ s: sym1 })).toEqual({});
+  expect(schema.encode({ s: sym2 })).toEqual({ s: sym2 });
+});
