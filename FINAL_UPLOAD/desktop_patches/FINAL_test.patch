+#!/bin/bash
+MODE=""
+OUTPUT_PATH=""
+
+# Parse arguments
+while [[ "$#" -gt 0 ]]; do
+    case $1 in
+        base|new) MODE="$1"; shift ;;
+        --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+        *) shift ;;
+    esac
+done
+
+if [ -z "$MODE" ]; then
+    MODE="default"
+fi
+
+REPORTER_ARGS=""
+if [ -n "$OUTPUT_PATH" ]; then
+    REPORTER_ARGS="--reporter mocha-junit-reporter --reporter-options mochaFile=${OUTPUT_PATH}"
+fi
+
+echo "Running ${MODE} mode" >&2
+
+# The benchmark environment might not have built the `lib` folder.
+# Many baseline tests require `../..` (which resolves to `lib/node/index.js`)
+# or `../../lib/utils`. We must build it to prevent MODULE_NOT_FOUND.
+npm run build:lib >/dev/null 2>&1 || true
+
+if [ "$MODE" = "base" ]; then
+    # Base mode: run ONLY existing baseline tests that pass at the base commit.
+    # We must explicitly load setup.js first because utils.js relies on global 'should'
+    ./node_modules/.bin/mocha test/support/setup.js test/node/utils.js --timeout 15000 --exit $REPORTER_ARGS
+elif [ "$MODE" = "new" ]; then
+    # New mode: run only the newly added tests
+    ./node_modules/.bin/mocha test/support/setup.js test/node/hidden_verify.js --timeout 15000 --exit $REPORTER_ARGS
+else
+    # Default: run everything
+    ./node_modules/.bin/mocha test/support/setup.js test/node/utils.js test/node/hidden_verify.js --timeout 15000 --exit $REPORTER_ARGS
+fi
diff --git a/test/node/hidden_verify.js b/test/node/hidden_verify.js
new file mode 100644
index 0000000..86317f8
--- /dev/null
+++ b/test/node/hidden_verify.js
@@ -0,0 +1,444 @@
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const request = require('../support/client');
+const getSetup = require('../support/setup');
+
+describe('hidden verification tests', function () {
+  this.timeout(10000);
+  let setup;
+  let base;
+
+  before(async () => {
+    setup = await getSetup();
+    base = setup.uri;
+  });
+
+  // T1: oversized response callback, code, state, and callback count
+  it('should invoke callback exactly once with an error with code ETOOLARGE on maxResponseSize exceeded', (done) => {
+    let callbacks = 0;
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(100))
+      .buffer(true);
+    assert.strictEqual(req.maxResponseSize(10), req, 'maxResponseSize() must be chainable');
+
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(error, 'Should emit an error');
+          assert.equal(error.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+        } catch (err) {
+          return done(err);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 50);
+      }
+    });
+  });
+
+  // T2: oversized .send() request callback
+  it('should emit exactly once an error with code ETOOLARGE on maxRequestSize exceeded (Node)', (done) => {
+    let callbacks = 0;
+    const req = request.post(`${base}/echo`);
+    assert.strictEqual(req.maxRequestSize(5), req, 'maxRequestSize() must be chainable');
+    req.send('1234567890');
+
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(error, 'Should emit an error for maxRequestSize');
+          assert.equal(error.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+        } catch (err) {
+          return done(err);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 50);
+      }
+    });
+  });
+
+  // T3: multibyte UTF-8 outgoing byte count
+  it('should measure byte length for multibyte UTF-8 strings in maxRequestSize', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(6)
+      .send('你好世界'); // 4 chars, 12 bytes
+
+    req.end((err, res) => {
+      try {
+        assert.ok(err, 'Multibyte string exceeding byte limit must produce error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T4: Buffer request overflow
+  it('should emit ETOOLARGE when Buffer payload exceeds maxRequestSize', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(10)
+      .send(Buffer.alloc(25, 'a'));
+
+    req.end((err, res) => {
+      try {
+        assert.ok(err, 'Buffer payload exceeding limit must produce error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T5: Route multipart formData through an upload progress monitor and emit upload progress
+  it('should route multipart formData through an upload progress monitor and emit upload progress', (done) => {
+    let uploadProgressSeen = false;
+    let uploadProgressLoaded = 0;
+
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1000000)
+      .field('user[name]', 'tobi')
+      .field('data', 'x'.repeat(65536)); // 64KB payload guarantees upload progress event fires
+
+    req.on('progress', (e) => {
+      if (e.direction === 'upload' && e.loaded > 0) {
+        uploadProgressSeen = true;
+        uploadProgressLoaded = e.loaded;
+      }
+    });
+
+    req.end((err, res) => {
+      if (err) return done(err);
+      try {
+        assert.strictEqual(req.hasSizeError(), false, 'hasSizeError() should be false');
+        assert.strictEqual(uploadProgressSeen, true, 'Upload progress event must be emitted during multipart upload');
+        assert.ok(uploadProgressLoaded > 0, 'Upload progress loaded bytes must be greater than zero');
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T6: successful in-limit multipart upload
+  it('should succeed for in-limit multipart upload with 200 status', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(10000)
+      .field('user[name]', 'tobi');
+
+    req.end((err, res) => {
+      try {
+        assert.ifError(err);
+        assert.strictEqual(res.status, 200);
+        assert.strictEqual(req.hasSizeError(), false);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T7: multipart overflow callback
+  it('should emit ETOOLARGE on maxRequestSize exceeded during multipart upload', (done) => {
+    let callbacks = 0;
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(10)
+      .field('user[name]', 'tobi_is_a_very_long_name_that_exceeds_10_bytes');
+
+    req.end((error, res) => {
+      callbacks++;
+      if (callbacks === 1) {
+        try {
+          assert.ok(error, 'Should emit an error for multipart maxRequestSize');
+          assert.equal(error.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true, 'hasSizeError() should be true');
+        } catch (err) {
+          return done(err);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbacks, 1, 'Callback should only be invoked once');
+            done();
+          } catch (err) {
+            done(err);
+          }
+        }, 50);
+      }
+    });
+  });
+
+  // T8: hasSizeError false when response is within limit
+  it('should return false from hasSizeError() when no size limit is exceeded', (done) => {
+    const req = request
+      .get(`${base}/`)
+      .maxResponseSize(100000);
+
+    req.end((err, res) => {
+      try {
+        assert.strictEqual(req.hasSizeError(), false,
+          'hasSizeError() must be false when response fits within limit');
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T9: request equality boundary
+  it('should not trigger ETOOLARGE when request payload is exactly at maxRequestSize boundary', (done) => {
+    const payload = 'hello'; // 5 bytes
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(5)
+      .send(payload);
+
+    req.end((err, res) => {
+      try {
+        assert.ok(
+          !err || err.code !== 'ETOOLARGE',
+          'Must NOT throw ETOOLARGE when payload length equals limit'
+        );
+        assert.strictEqual(req.hasSizeError(), false,
+          'hasSizeError() must be false when payload is exactly at limit');
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T10: response equality boundary
+  it('should not trigger ETOOLARGE when response is exactly at maxResponseSize boundary', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(10))
+      .buffer(true)
+      .maxResponseSize(10);
+
+    req.end((err, res) => {
+      try {
+        assert.ok(
+          !err || err.code !== 'ETOOLARGE',
+          'Must NOT throw ETOOLARGE when response length equals limit'
+        );
+        assert.strictEqual(req.hasSizeError(), false,
+          'hasSizeError() must be false when response is exactly at limit');
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T11: initial hasSizeError return
+  it('hasSizeError() should return strict boolean false before any request is made', () => {
+    const req = request.get(`${base}/`);
+    const result = req.hasSizeError();
+    assert.strictEqual(typeof result, 'boolean', 'hasSizeError() must return a boolean');
+    assert.strictEqual(result, false, 'hasSizeError() must be false before request');
+  });
+
+  // T12: hasSizeError after response overflow
+  it('hasSizeError() should return strict boolean true after a maxResponseSize error', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(200))
+      .buffer(true)
+      .maxResponseSize(5);
+
+    req.end((err) => {
+      try {
+        const result = req.hasSizeError();
+        assert.strictEqual(typeof result, 'boolean', 'hasSizeError() must return a boolean');
+        assert.strictEqual(result, true, 'hasSizeError() must be strict true after size error');
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T13: cumulative Request.write() overflow
+  it('should emit ETOOLARGE when cumulative Request.write() exceeds maxRequestSize', (done) => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(8);
+
+    req.write('12345');
+    req.write('67890');
+
+    req.end((err, res) => {
+      try {
+        assert.ok(err, 'Cumulative write exceeding limit must error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T14: multipart reported Content-Length overflow
+  it('should enforce maxRequestSize using reported Content-Length for multipart', (done) => {
+    const tmpFile = path.join(__dirname, 'test_tmp_' + Date.now() + '.txt');
+    fs.writeFileSync(tmpFile, 'a'.repeat(100));
+
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(1)
+      .attach('test', tmpFile);
+
+    req.end((err, res) => {
+      try {
+        fs.unlinkSync(tmpFile);
+      } catch (_) {}
+
+      try {
+        assert.ok(err, 'Content-Length overflow should produce error');
+        assert.equal(err.code, 'ETOOLARGE');
+        assert.strictEqual(req.hasSizeError(), true);
+        done();
+      } catch (e) {
+        done(e);
+      }
+    });
+  });
+
+  // T15: Promise rejection for response overflow
+  it('should reject Promise with ETOOLARGE on response overflow', async () => {
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(100))
+      .buffer(true)
+      .maxResponseSize(5);
+
+    try {
+      await req;
+      assert.fail('Promise should have rejected');
+    } catch (err) {
+      assert.ok(err instanceof Error);
+      assert.equal(err.code, 'ETOOLARGE');
+      assert.strictEqual(req.hasSizeError(), true);
+    }
+  });
+
+  // T16: Promise rejection for request overflow
+  it('should reject Promise with ETOOLARGE on request overflow', async () => {
+    const req = request
+      .post(`${base}/echo`)
+      .maxRequestSize(5)
+      .send('1234567890');
+
+    try {
+      await req;
+      assert.fail('Promise should have rejected');
+    } catch (err) {
+      assert.ok(err instanceof Error);
+      assert.equal(err.code, 'ETOOLARGE');
+      assert.strictEqual(req.hasSizeError(), true);
+    }
+  });
+
+  // T17: hasSizeError after Promise response request
+  it('should have hasSizeError true after Promise response overflow', async () => {
+    const req = request
+      .post(`${base}/echo`)
+      .send('x'.repeat(100))
+      .buffer(true)
+      .maxResponseSize(5);
+
+    try {
+      await req;
+    } catch (_) {}
+    assert.strictEqual(req.hasSizeError(), true);
+  });
+
+  // T18: request overflow with retry(3)
+  it('should not retry request size error when retry(3) is configured', (done) => {
+    let callbackCount = 0;
+    const req = request
+      .post(`${base}/echo`)
+      .retry(3)
+      .maxRequestSize(5)
+      .send('1234567890');
+
+    req.end((err, res) => {
+      callbackCount++;
+      if (callbackCount === 1) {
+        try {
+          assert.ok(err, 'Must produce error');
+          assert.equal(err.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true);
+        } catch (e) {
+          return done(e);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbackCount, 1, 'Callback must fire exactly once - request size error must NOT trigger a retry');
+            done();
+          } catch (e) {
+            done(e);
+          }
+        }, 100);
+      }
+    });
+  });
+
+  // T19: response overflow with retry(3)
+  it('should not retry response size error when retry(3) is configured', (done) => {
+    let callbackCount = 0;
+    const req = request
+      .post(`${base}/echo`)
+      .retry(3)
+      .maxResponseSize(5)
+      .send('x'.repeat(100))
+      .buffer(true);
+
+    req.end((err, res) => {
+      callbackCount++;
+      if (callbackCount === 1) {
+        try {
+          assert.ok(err, 'Must produce error');
+          assert.equal(err.code, 'ETOOLARGE');
+          assert.strictEqual(req.hasSizeError(), true);
+        } catch (e) {
+          return done(e);
+        }
+        setTimeout(() => {
+          try {
+            assert.equal(callbackCount, 1, 'Callback must fire exactly once - response size error must NOT trigger a retry');
+            done();
+          } catch (e) {
+            done(e);
+          }
+        }, 100);
+      }
+    });
+  });
+});
