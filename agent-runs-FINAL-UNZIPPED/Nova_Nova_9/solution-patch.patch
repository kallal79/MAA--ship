+function hasPerfectMatching(edges: boolean[][]): boolean {
+  const matched = new Array(edges.length).fill(-1);
+  const visit = (left: number, seen: boolean[]): boolean => {
+    for (let right = 0; right < edges[left]!.length; right++) {
+      if (!edges[left]![right] || seen[right]) continue;
+      seen[right] = true;
+      if (matched[right] === -1 || visit(matched[right]!, seen)) {
+        matched[right] = left;
