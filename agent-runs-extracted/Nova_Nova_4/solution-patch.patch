+test("skipEncoding omits defaults only inside containers", () => {
+  const skipped = z.string().default("x", { skipEncoding: true });
+
+  expect(z.encode(skipped, "x")).toBe("x");
+  expect(z.encode(z.object({ value: skipped }), { value: "x" })).toEqual({});
+  expect(z.encode(z.record(z.string(), skipped), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), skipped),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.encode(z.array(skipped), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([skipped, z.string()]), ["x", "y"])).toEqual(["y"]);
+  expect(z.encode(z.set(skipped), new Set(["x", "y"]))).toEqual(new Set(["y"]));
+});
+
+test("skipEncoding equality modes", () => {
+  const value = { nested: { value: 1 }, date: new Date(123) };
+  const object = (skipEncoding: true | { mode: "strict" | "shallow" | "deep" }) =>
+    z.object({
+      value: z.object({ nested: z.object({ value: z.number() }), date: z.date() }).default(value, { skipEncoding }),
+    });
+
+  expect(z.encode(object({ mode: "strict" }), { value })).toEqual({});
+  expect(z.encode(object({ mode: "strict" }), { value: { ...value } })).toHaveProperty("value");
+  expect(z.encode(object({ mode: "shallow" }), { value: { ...value } })).toEqual({});
+  expect(
+    z.encode(object({ mode: "shallow" }), { value: { nested: { value: 1 }, date: new Date(123) } })
+  ).toHaveProperty("value");
+  expect(z.encode(object({ mode: "deep" }), { value: { nested: { value: 1 }, date: new Date(123) } })).toEqual({});
+  expect(z.encode(object(true), { value: { nested: { value: 1 }, date: new Date(123) } })).toEqual({});
+});
+
+test("deep skipEncoding compares maps and sets without order", () => {
+  const defaultMap = new Map<{ id: number }, Set<{ value: string }>>([
+    [{ id: 1 }, new Set([{ value: "a" }, { value: "b" }])],
+    [{ id: 2 }, new Set([{ value: "c" }])],
+  ]);
+  const schema = z.object({
+    value: z.map(z.object({ id: z.number() }), z.set(z.object({ value: z.string() }))).default(defaultMap, {
+      skipEncoding: { mode: "deep" },
+    }),
+  });
+  const reordered = new Map<{ id: number }, Set<{ value: string }>>([
+    [{ id: 2 }, new Set([{ value: "c" }])],
+    [{ id: 1 }, new Set([{ value: "b" }, { value: "a" }])],
+  ]);
+
+  expect(z.encode(schema, { value: reordered })).toEqual({});
+});
+
+test("skipEncoding predicates and wrapper chains", async () => {
+  const inner = z.string().default("inner", { skipEncoding: (value) => value === "inner" });
+  const chained = inner.default("outer", { skipEncoding: (value) => value === "outer" });
+  const wrapped = chained.optional().nullable();
+  const schema = z.object({ value: wrapped });
+
+  expect(z.encode(schema, { value: "inner" })).toEqual({});
+  expect(z.encode(schema, { value: "outer" })).toEqual({});
+  expect(z.encode(schema, { value: "other" })).toEqual({ value: "other" });
+
+  const asyncDefault = z.string().default("x", { skipEncoding: async (value) => value === "x" });
