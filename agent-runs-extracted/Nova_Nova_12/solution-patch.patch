+test("skipEncoding omits defaults from containers but not at the root", () => {
+  const value = z.string().default("x", { skipEncoding: true });
+
+  expect(value.encode("x")).toBe("x");
+  expect(z.object({ value }).encode({ value: "x" })).toEqual({});
+  expect(z.record(z.string(), value).encode({ a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.map(z.string(), value).encode(
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.array(value).encode(["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.tuple([value, z.string(), value]).encode(["x", "a", "x"])).toEqual(["a"]);
+  expect(z.set(value).encode(new Set(["a", "x", "b"]))).toEqual(new Set(["a", "b"]));
+});
+
+test("skipEncoding equality modes", () => {
+  const defaultValue = { nested: { value: 1 }, date: new Date(100) };
+  const schema = z.object({ nested: z.object({ value: z.number() }), date: z.date() });
+
