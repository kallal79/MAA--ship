+  expect(z.object({ value: strict }).encode({ value: { ...defaultValue } })).toHaveProperty("value");
+
+  const shallow = schema.default(defaultValue, { skipEncoding: { mode: "shallow" } });
+  expect(z.object({ value: shallow }).encode({ value: { ...defaultValue } })).toEqual({});
+  expect(z.object({ value: shallow }).encode({ value: { nested: { value: 1 }, date: new Date(100) } })).toHaveProperty(
+    "value"
+  );
+
+  const deep = schema.default(defaultValue, { skipEncoding: { mode: "deep" } });
+  expect(z.object({ value: deep }).encode({ value: { nested: { value: 1 }, date: new Date(100) } })).toEqual({});
+});
+
+test("skipEncoding deep equality compares maps and sets without regard to order", () => {
