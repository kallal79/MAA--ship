+
+test("skipEncoding omits encoded static defaults", () => {
+  const lower = z.codec(z.string(), z.string(), {
+    decode: (value) => value.toUpperCase(),
+    encode: (value) => value.toLowerCase(),
+  });
+  const schema = z.object({ value: lower.default("HELLO", { skipEncoding: true }) });
+
+  expect(z.encode(schema, { value: "HELLO" })).toEqual({});
+  expect(z.encode(schema, { value: "WORLD" })).toEqual({ value: "world" });
+});
+
+test("skipEncoding comparison modes", () => {
+  const nested = { value: 1 };
+  const deepDefault = { a: nested, b: new Set([{ value: Number.NaN }]) };
+
+  expect(
+    z.encode(z.any().default(deepDefault, { skipEncoding: true }), {
+      b: new Set([{ value: Number.NaN }]),
+      a: { value: 1 },
+    })
+  ).toBeUndefined();
+  expect(z.encode(z.any().default([undefined], { skipEncoding: true }), Array(1))).toBeUndefined();
+  expect(
+    z.encode(z.any().default({ a: nested }, { skipEncoding: { mode: "shallow" } }), { a: nested })
+  ).toBeUndefined();
+  expect(z.encode(z.any().default({ a: nested }, { skipEncoding: { mode: "shallow" } }), { a: { value: 1 } })).toEqual({
+    a: { value: 1 },
+  });
+  expect(z.encode(z.any().default(nested, { skipEncoding: { mode: "strict" } }), nested)).toBeUndefined();
+  expect(z.encode(z.any().default(nested, { skipEncoding: { mode: "strict" } }), { value: 1 })).toEqual({ value: 1 });
+  expect(z.encode(z.nan().default(Number.NaN, { skipEncoding: { mode: "strict" } }), Number.NaN)).toBeUndefined();
+});
+
+test("skipEncoding propagates through structural schemas", () => {
+  const omitted = z.string().default("x", { skipEncoding: true });
+
+  expect(z.encode(z.array(omitted), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([omitted, z.string()]), ["x", "y"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([omitted, z.string().optional()]), ["x"])).toEqual([]);
+  expect(z.encode(z.record(z.string(), omitted), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), omitted),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.encode(z.object({ value: z.union([omitted, z.number()]) }), { value: "x" })).toEqual({});
+  expect(z.encode(z.object({ value: z.lazy(() => omitted) }).passthrough(), { value: "x", extra: 1 })).toEqual({
+    extra: 1,
+  });
+  expect(z.encode(z.object({ value: z.intersection(omitted, z.string()) }), { value: "x" })).toEqual({});
+});
+
+test("skipEncoding predicates and factory defaults", async () => {
+  const rawDefault = { value: 1 };
+  const predicate = vi.fn((encoded: unknown, raw: unknown) => encoded === "one" && raw === rawDefault);
+  const schema = z
+    .codec(z.string(), z.object({ value: z.number() }), {
+      decode: (value) => ({ value: Number(value) }),
+      encode: (value) => (value.value === 1 ? "one" : String(value.value)),
+    })
+    .default(rawDefault, { skipEncoding: predicate });
+
+  expect(z.encode(schema, rawDefault)).toBeUndefined();
+  expect(predicate).toHaveBeenCalledOnce();
+
+  const factoryPredicate = vi.fn(async (_encoded: unknown, raw: unknown) => raw === undefined);
+  const factory = z.string().default(() => "x", { skipEncoding: factoryPredicate });
+  expect(() => z.encode(factory, "x")).toThrow("Cannot use async skipEncoding in synchronous encode");
+  await expect(z.encodeAsync(factory, "x")).resolves.toBeUndefined();
+  expect(factoryPredicate).toHaveBeenLastCalledWith("x", undefined);
+
+  expect(() => z.string().default(() => "x", { skipEncoding: true })).toThrow(
+    "Cannot use skipEncoding: true with a factory default"
+  );
+  expect(() => z.string().default(() => "x", { skipEncoding: { mode: "deep" } })).toThrow(
+    'Cannot use skipEncoding: {"mode":"deep"} with a factory default'
+  );
+});
