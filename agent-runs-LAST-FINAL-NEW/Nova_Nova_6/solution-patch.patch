+  const strictNumber = z.union([z.nan(), z.number()]).default(Number.NaN, { skipEncoding: { mode: "strict" } });
+  const shallow = z
+    .object({
+      date: z.date(),
+      nested: z.object({ value: z.number() }),
+      values: z.array(z.object({ value: z.number() })),
+    })
+    .default(defaultValue, { skipEncoding: { mode: "shallow" } });
+  const deep = shallow.unwrap().default(defaultValue, { skipEncoding: true });
+
+  expect(z.array(strict).encode([{ value: 1 }])).toEqual([{ value: 1 }]);
+  expect(z.array(strictNumber).encode([Number.NaN, 0])).toEqual([0]);
+  expect(z.array(shallow).encode([{ ...defaultValue }])).toEqual([]);
+  expect(z.array(shallow).encode([{ ...defaultValue, nested: { value: 1 } }])).toHaveLength(1);
+  expect(z.array(deep).encode([{ date: new Date(1), nested: { value: 1 }, values: [{ value: 1 }] }])).toEqual([]);
