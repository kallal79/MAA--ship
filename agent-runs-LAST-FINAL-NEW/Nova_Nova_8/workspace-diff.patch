+  // Value mismatch
+  expect(
+    schema.encode({
+      m: new Map([
+        ["k1", { a: 1 }],
+        ["k2", { a: 3 }],
+      ]),
+    })
+  ).toEqual({
+    m: new Map([
+      ["k1", { a: 1 }],
+      ["k2", { a: 3 }],
+    ]),
+  });
+});
+
+test("Set deep equality is order-insensitive and deeply compares elements", () => {
+  const schema = z.object({
+    s: z.set(z.object({ a: z.number() })).default(new Set([{ a: 1 }, { a: 2 }]), { skipEncoding: true }),
+  });
+
+  // Exact match, different order
+  expect(schema.encode({ s: new Set([{ a: 2 }, { a: 1 }]) })).toEqual({});
+
+  // Element mismatch
+  expect(schema.encode({ s: new Set([{ a: 1 }, { a: 3 }]) })).toEqual({
+    s: new Set([{ a: 1 }, { a: 3 }]),
+  });
+});
+
+test("sync predicate", () => {
+  const schema = z.object({
+    a: z.number().default(1, { skipEncoding: (v: any) => v === 1 }),
+  });
+  expect(schema.encode({ a: 1 })).toEqual({});
+  expect(schema.encode({ a: 2 })).toEqual({ a: 2 });
+});
+
+test("predicate input timing", () => {
+  // The predicate should receive the fully encoded child result,
+  // not the raw input. We can test this by checking if the outer predicate sees the inner omitted value.
+  const schema = z.object({
+    outer: z
+      .object({
+        inner: z.number().default(0, { skipEncoding: true }),
+      })
+      .default(
+        { inner: 0 },
+        {
+          skipEncoding: (v: any) => {
+            // v should be the fully encoded child result { }, not { inner: 0 }
+            return Object.keys(v).length === 0;
+          },
+        }
+      ),
+  });
+
+  // inner = 0 matches inner default -> inner is omitted -> {}
+  // outer predicate sees {}, returns true -> outer is omitted -> {}
+  expect(schema.encode({ outer: { inner: 0 } })).toEqual({});
+
+  // inner = 1 does not match inner default -> { inner: 1 }
+  // outer predicate sees { inner: 1 }, returns false -> outer is kept
+  expect(schema.encode({ outer: { inner: 1 } })).toEqual({ outer: { inner: 1 } });
+});
+
+test("container-level defaults", () => {
+  const schema = z.object({
+    obj: z.record(z.string(), z.number()).default({ a: 1 }, { skipEncoding: true }),
+    arr: z.array(z.number()).default([1, 2], { skipEncoding: true }),
+  });
+  expect(schema.encode({ obj: { a: 1 }, arr: [1, 2] })).toEqual({});
+});
+
+test("wrapper interaction", () => {
+  const schema = z.object({
+    opt: z.number().default(0, { skipEncoding: true }).optional(),
+    nul: z.number().default(0, { skipEncoding: true }).nullable(),
+  });
+  expect(schema.encode({ opt: 0, nul: 0 })).toEqual({});
+});
+
+test("encodeAsync + factory + predicate", async () => {
+  const schema = z.object({
