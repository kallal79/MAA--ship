+  const value = z.map(entry, z.set(entry)).default(mapDefault, { skipEncoding: true });
+  const reordered = new Map([
+    [{ id: 4 }, new Set([{ id: 5 }])],
+    [{ id: 1 }, new Set([{ id: 3 }, { id: 2 }])],
+  ]);
+
+  expect(z.encode(z.object({ value }), { value: reordered })).toEqual({});
+});
+
+test("skipEncoding predicates support async encoding", async () => {
