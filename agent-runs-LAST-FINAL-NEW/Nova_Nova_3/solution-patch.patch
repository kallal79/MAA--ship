+  const sync = z.string().default("default", { skipEncoding: (value) => value.startsWith("skip") });
+  const refined = z
+    .string()
+    .default("default", {
+      skipEncoding: (value) => {
+        calls++;
+        return value === "default";
+      },
+    })
+    .refine(() => true);
+  const async = z.string().default("default", {
+    skipEncoding: async (value) => value.startsWith("skip"),
