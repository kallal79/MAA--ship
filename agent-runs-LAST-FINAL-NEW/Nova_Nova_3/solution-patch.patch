+test("skipEncoding omits defaults only inside containers", () => {
+  const value = z.string().default("default", { skipEncoding: true });
+
+  expect(z.encode(value, "default")).toBe("default");
+  expect(z.encode(z.object({ value }), { value: "default" })).toEqual({});
+  expect(z.encode(z.record(z.string(), value), { a: "default", b: "other" })).toEqual({ b: "other" });
+  expect(z.encode(z.map(z.string(), value), new Map([["a", "default"]]))).toEqual(new Map());
+  expect(z.encode(z.array(value), ["other", "default", "last"])).toEqual(["other", "last"]);
+  expect(z.encode(z.tuple([value, z.string(), value]), ["default", "middle", "default"])).toEqual(["middle"]);
+  expect(z.encode(z.set(value), new Set(["default", "other"]))).toEqual(new Set(["other"]));
+});
+
+test("skipEncoding equality modes", () => {
+  const shared = { value: 1 };
+  const defaultValue = { date: new Date(1), nested: shared };
+
+  const strict = z.object({ date: z.date(), nested: z.object({ value: z.number() }) }).default(defaultValue, {
+    skipEncoding: { mode: "strict" },
+  });
+  const shallow = z.object({ date: z.date(), nested: z.object({ value: z.number() }) }).default(defaultValue, {
+    skipEncoding: { mode: "shallow" },
+  });
+  const deep = z.object({ date: z.date(), nested: z.object({ value: z.number() }) }).default(defaultValue, {
+    skipEncoding: { mode: "deep" },
+  });
+
+  expect(z.encode(z.object({ strict }), { strict: defaultValue })).toEqual({});
+  expect(z.encode(z.object({ strict }), { strict: { ...defaultValue } })).toHaveProperty("strict");
+  expect(z.encode(z.object({ shallow }), { shallow: { ...defaultValue } })).toEqual({});
+  expect(z.encode(z.object({ shallow }), { shallow: { date: new Date(1), nested: { value: 1 } } })).toHaveProperty(
+    "shallow"
+  );
+  expect(z.encode(z.object({ deep }), { deep: { date: new Date(1), nested: { value: 1 } } })).toEqual({});
+});
+
+test("skipEncoding deep equality supports order-independent maps and sets", () => {
