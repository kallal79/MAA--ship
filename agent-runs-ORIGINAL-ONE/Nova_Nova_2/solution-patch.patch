+});
+
+test("supports dynamic and factory default omission", async () => {
+  let rawDefault: unknown;
+  const schema = z.object({
+    value: z.string().default("x", {
+      skipEncoding: (encoded, raw) => {
+        rawDefault = raw;
+        return encoded === "x" && raw === "x";
+      },
+    }),
+  });
