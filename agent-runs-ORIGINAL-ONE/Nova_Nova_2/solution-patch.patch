+
+test("omits encoded static defaults from containers", () => {
+  const schema = z.object({
+    a: z.string().default("a"),
+    b: z.string().default("b", { skipEncoding: true }),
+    c: z.string().default("c", { skipEncoding: false }),
+  });
+
+  expect(z.encode(schema, { a: "a", b: "changed", c: "c" })).toEqual({ b: "changed", c: "c" });
+  expect(z.encode(schema, { a: "a", b: "b", c: "c" })).toEqual({ c: "c" });
+
+  const record = z.record(z.string(), z.number().default(1));
+  expect(z.encode(record, { a: 1, b: 2 })).toEqual({ b: 2 });
+
+  const map = z.map(z.string(), z.number().default(1));
+  expect(
+    z.encode(
+      map,
+      new Map([
+        ["a", 1],
+        ["b", 2],
+      ])
+    )
+  ).toEqual(new Map([["b", 2]]));
+});
+
+test("compares encoded defaults deeply", () => {
+  const objectSchema = z.object({
+    value: z.object({ a: z.number(), b: z.number() }).default({ a: 1, b: 2 }),
+  });
+  expect(z.encode(objectSchema, { value: { b: 2, a: 1 } })).toEqual({});
+
+  const mapSchema = z.object({
+    map: z.map(z.string(), z.object({ value: z.number() })).default(new Map([["a", { value: 1 }]])),
+  });
+  expect(z.encode(mapSchema, { map: new Map([["a", { value: 1 }]]) })).toEqual({});
+
+  const setSchema = z.object({
+    set: z.set(z.object({ value: z.number() })).default(new Set([{ value: 1 }])),
+  });
+  expect(z.encode(setSchema, { set: new Set([{ value: 1 }]) })).toEqual({});
+
+  const arraySchema = z.array(z.number().default(0));
+  const encoded = z.encode(arraySchema, [0, 2]);
+  expect(encoded.length).toBe(2);
+  expect(0 in encoded).toBe(false);
+  expect(encoded[1]).toBe(2);
+});
+
+test("supports default comparison modes", () => {
+  const value = { nested: { value: 1 } };
+  const shallow = z.object({
+    value: z.object({ nested: z.object({ value: z.number() }) }).default(value, { mode: "shallow" }),
+  });
+  const deep = z.object({
+    value: z.object({ nested: z.object({ value: z.number() }) }).default(value, { mode: "deep" }),
+  });
+  const strict = z.object({
+    value: z.object({ nested: z.object({ value: z.number() }) }).default(value, { mode: "strict" }),
+  });
+
+  expect(z.encode(shallow, { value })).toEqual({ value });
+  expect(z.encode(deep, { value })).toEqual({});
+  expect(z.encode(strict, { value })).toEqual({ value });
+
+  const map = z.object({
+    map: z
+      .map(z.object({ key: z.number() }), z.object({ value: z.number() }))
+      .default(new Map([[{ key: 1 }, { value: 2 }]]), { mode: "shallow" }),
+  });
+  expect(z.encode(map, { map: new Map([[{ key: 1 }, { value: 2 }]]) })).toEqual({
+    map: new Map([[{ key: 1 }, { value: 2 }]]),
+  });
+});
+
+test("compacts tuples and preserves omission through wrappers", () => {
