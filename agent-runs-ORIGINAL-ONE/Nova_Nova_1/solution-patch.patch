@@ -407,3 +407,95 @@ test("direction-aware defaults", () => {
     }
   `);
 });
+
+test("encode omits values matching encoded defaults", () => {
+  const numberCodec = z.codec(z.string(), z.number(), {
+    decode: Number,
+    encode: String,
+  });
+  const schema = z.object({
+    omitted: numberCodec.default(5),
+    kept: numberCodec.default(5),
+  });
+
+  expect(z.encode(schema, { omitted: 5, kept: 6 })).toEqual({ kept: "6" });
+});
+
+test("encode default comparisons support shallow, deep, and strict modes", () => {
+  const defaultValue = { nested: { value: 1 }, count: 1 };
+  const input = { count: 1, nested: { value: 1 } };
+
+  const deep = z.object({ value: z.any().default(defaultValue) });
+  const shallow = z.object({ value: z.any().default(defaultValue, { mode: "shallow" }) });
+  const strict = z.object({ value: z.any().default(defaultValue, { mode: "strict" }) });
+
+  expect(z.encode(deep, { value: input })).toEqual({});
+  expect(z.encode(shallow, { value: input })).toEqual({ value: input });
+  expect(z.encode(strict, { value: input })).toEqual({ value: input });
+
+  const sparse: string[] = [];
+  sparse.length = 1;
+  const sparseInput = Array<string>(1);
+  const sparseSchema = z.object({ value: z.any().default(sparse) });
+  expect(z.encode(sparseSchema, { value: sparseInput })).toEqual({});
+
+  const map = new Map([[{ key: 1 }, { value: 2 }]]);
+  const set = new Set([{ value: 1 }]);
+  const collections = z.object({
+    map: z.any().default(map),
+    set: z.any().default(set),
+  });
+  expect(
+    z.encode(collections, {
+      map: new Map([[{ key: 1 }, { value: 2 }]]),
+      set: new Set([{ value: 1 }]),
+    })
+  ).toEqual({});
+});
+
+test("encode omission follows container semantics", () => {
+  const defaultString = z.string().default("x");
+
+  const array = z.encode(z.array(defaultString), ["x", "y"]);
+  expect(array).toHaveLength(2);
+  expect(0 in array).toBe(false);
+  expect(array[1]).toBe("y");
+
+  expect(z.encode(z.tuple([defaultString, z.string()]), ["x", "y"])).toEqual(["y"]);
+  expect(z.encode(z.record(z.string(), defaultString), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect([
+    ...z.encode(
+      z.map(z.string(), defaultString),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    ),
+  ]).toEqual([["b", "y"]]);
+  expect([...z.encode(z.set(defaultString), new Set(["x", "y"]))]).toEqual(["y"]);
+
+  const wrapped = z.object({ value: defaultString.nullable().optional() });
+  expect(z.encode(wrapped, { value: "x" })).toEqual({});
+});
+
+test("factory defaults use predicates for encode omission", async () => {
+  const factory = z.string().default(() => "x");
+  expect(z.encode(z.object({ value: factory }), { value: "x" })).toEqual({ value: "x" });
+
+  expect(() => z.string().default(() => "x", true)).toThrow("Cannot use skipEncoding: with a factory default");
+  expect(() => z.string().default(() => "x", { mode: "strict" })).toThrow(
+    "Cannot use skipEncoding: with a factory default"
+  );
+
+  const predicate = z.string().default(
+    () => "x",
+    (encoded, rawDefault) => encoded === "x" && rawDefault === undefined
+  );
+  expect(z.encode(z.object({ value: predicate }), { value: "x" })).toEqual({});
+
+  const asyncPredicate = z.string().default("x", async () => true);
+  expect(() => z.encode(z.object({ value: asyncPredicate }), { value: "x" })).toThrow(
+    "Cannot use async skipEncoding in synchronous encode"
+  );
+  await expect(z.encodeAsync(z.object({ value: asyncPredicate }), { value: "x" })).resolves.toEqual({});
+});
