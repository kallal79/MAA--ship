+test("skipEncoding encodes static defaults before deep comparison", () => {
+  const stringNumber = z.codec(z.string(), z.number(), {
+    decode: (value) => Number(value),
+    encode: (value) => String(value),
+  });
+  const schema = z.object({ value: stringNumber.default(12, { skipEncoding: true }) });
+
+  expect(z.encode(schema, { value: 12 })).toEqual({});
+  expect(z.encode(schema, { value: 13 })).toEqual({ value: "13" });
+});
+
+test("skipEncoding comparison modes", () => {
+  const deep = z.object({ value: z.unknown().default({ a: [1, { b: 2 }] }, { skipEncoding: true }) });
+  expect(z.encode(deep, { value: { a: [1, { b: 2 }] } })).toEqual({});
+
+  const shallowDefault = { nested: {} };
+  const shallow = z.object({
+    value: z.unknown().default(shallowDefault, { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(z.encode(shallow, { value: { nested: {} } })).toEqual({ value: { nested: {} } });
+
+  const strict = z.object({ value: z.unknown().default(1, { skipEncoding: { mode: "strict" } }) });
+  expect(z.encode(strict, { value: 1 })).toEqual({});
+  expect(z.encode(strict, { value: 2 })).toEqual({ value: 2 });
+});
+
+test("deep skipEncoding supports sparse arrays, objects, maps, and sets", () => {
+  const sparse = Array(1);
+  const defaults = {
+    sparse,
+    object: { a: 1, b: 2 },
+    map: new Map<any, any>([[{ key: 1 }, { value: 2 }]]),
+    set: new Set<any>([{ value: 1 }, { value: 2 }]),
+  };
+  const schema = z.object({ value: z.unknown().default(defaults, { skipEncoding: true }) });
+  const value = {
+    sparse: [undefined],
+    object: { b: 2, a: 1 },
+    map: new Map<any, any>([[{ key: 1 }, { value: 2 }]]),
+    set: new Set<any>([{ value: 2 }, { value: 1 }]),
+  };
+  expect(z.encode(schema, { value })).toEqual({});
+});
+
+test("skipEncoding omission propagates through structural schemas", () => {
+  const omitted = z.string().default("x", { skipEncoding: true });
+
+  expect(z.encode(z.array(omitted), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([z.string(), omitted, z.string()]), ["a", "x", "c"])).toEqual(["a", "c"]);
+  expect(z.encode(z.record(z.string(), omitted), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), omitted),
+      new Map([
