+#!/bin/bash
+
+OUTPUT_PATH=""
+MODE="new"
+
+while [[ "$#" -gt 0 ]]; do
+    case $1 in
+        --output_path) OUTPUT_PATH="$2"; shift ;;
+        base) MODE="base" ;;
+        new) MODE="new" ;;
+        *) ;;
+    esac
+    shift
+done
+
+if [ -n "$OUTPUT_PATH" ]; then
+  if [ "$MODE" = "base" ]; then
+    npx vitest run packages/zod/src/v4/classic/tests/default.test.ts --reporter=junit --outputFile="$OUTPUT_PATH"
+  else
+    npx vitest run packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.test.ts --reporter=junit --outputFile="$OUTPUT_PATH"
+  fi
+else
+  if [ "$MODE" = "base" ]; then
+    npx vitest run packages/zod/src/v4/classic/tests/default.test.ts
+  else
+    npx vitest run packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.test.ts
+  fi
+fi
