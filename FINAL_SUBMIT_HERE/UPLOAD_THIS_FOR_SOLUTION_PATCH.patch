+});
+
+test("skipEncoding predicate receives encoded value and raw default", () => {
+  const rawDefault = { value: "  x  " };
+  const schema = z.object({
+    a: z.object({ value: z.string().trim() }).default(rawDefault, {
+      skipEncoding: (encodedValue, rawDefaultValue) => {
+        expect(encodedValue).toEqual({ value: "x" });
