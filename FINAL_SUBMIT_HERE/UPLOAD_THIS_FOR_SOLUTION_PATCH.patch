+test("skipEncoding omits defaults during encode", async () => {
+  const stringDefault = z.string().default("x", { skipEncoding: true });
+  const object = z.object({ a: stringDefault, b: z.string().default("y", { skipEncoding: true }).optional() });
+  expect(z.encode(object, { a: "x", b: "y" })).toEqual({});
+  expect(z.encode(object, { a: "x", b: "z" })).toEqual({ b: "z" });
+  expect(z.encode(stringDefault, "x")).toBe("x");
+
+  expect(z.encode(z.array(stringDefault), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.tuple([stringDefault, z.string(), stringDefault]), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.set(stringDefault), new Set(["a", "x", "b"]))).toEqual(new Set(["a", "b"]));
+
+  expect(
+    z.encode(z.record(z.string().default("drop", { skipEncoding: true }), z.number()), { drop: 1, keep: 2 })
+  ).toEqual({ keep: 2 });
+  expect(z.encode(z.record(z.string(), z.number().default(0, { skipEncoding: true })), { a: 0, b: 1 })).toEqual({
+    b: 1,
+  });
+  expect(
+    z.encode(
+      z.map(z.string().default("drop", { skipEncoding: true }), z.number()),
+      new Map([
+        ["drop", 1],
+        ["keep", 2],
+      ])
+    )
+  ).toEqual(new Map([["keep", 2]]));
+  expect(
+    z.encode(
+      z.map(z.string(), z.number().default(0, { skipEncoding: true })),
+      new Map([
+        ["a", 0],
+        ["b", 1],
+      ])
+    )
+  ).toEqual(new Map([["b", 1]]));
+
+  const asyncSchema = z.object({ a: z.string().default("x", { skipEncoding: async () => true }) });
+  expect(() => z.encode(asyncSchema, { a: "x" })).toThrow("Cannot use async skipEncoding in synchronous encode");
+  await expect(z.encodeAsync(asyncSchema, { a: "x" })).resolves.toEqual({});
+});
+
+test("skipEncoding equality modes compare encoded values", () => {
+  const trimmed = z
+    .string()
+    .trim()
+    .default("  x  ", { skipEncoding: { mode: "strict" } });
+  expect(z.encode(z.object({ a: trimmed }), { a: "x" })).toEqual({});
+
+  const shallow = z.object({
+    a: z.array(z.object({ x: z.number() })).default([{ x: 1 }], { skipEncoding: { mode: "shallow" } }),
+  });
+  expect(z.encode(shallow, { a: [{ x: 1 }] })).toEqual({ a: [{ x: 1 }] });
+  const deep = z.object({ a: z.array(z.object({ x: z.number() })).default([{ x: 1 }], { skipEncoding: true }) });
+  expect(z.encode(deep, { a: [{ x: 1 }] })).toEqual({});
+
+  const date = new Date(0);
+  expect(z.encode(z.object({ a: z.date().default(new Date(0), { skipEncoding: true }) }), { a: date })).toEqual({});
+  expect(
+    z.encode(z.object({ a: z.set(z.object({ x: z.number() })).default(new Set([{ x: 1 }]), { skipEncoding: true }) }), {
+      a: new Set([{ x: 1 }]),
