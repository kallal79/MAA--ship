+test("skipEncoding compares encoded static defaults", () => {
+  const numberString = z.codec(z.string(), z.number(), { decode: Number, encode: String });
+  const schema = z.object({ value: numberString.default(1) });
+
+  expect(z.encode(schema, { value: 1 })).toEqual({});
+  expect(z.encode(schema, { value: 2 })).toEqual({ value: "2" });
+  expect(z.encode(numberString.default(1), 1)).toBeUndefined();
+});
+
+test("skipEncoding comparison modes", () => {
+  const nested = { value: 1 };
+  const value = { nested };
+  const object = z.object({ nested: z.unknown() });
+
+  expect(z.encode(object.default(value), { nested: { value: 1 } })).toBeUndefined();
+  expect(z.encode(object.default(value, { skipEncoding: { mode: "shallow" } }), { nested })).toBeUndefined();
+  expect(z.encode(object.default(value, { skipEncoding: { mode: "shallow" } }), { nested: { value: 1 } })).toEqual({
+    nested: { value: 1 },
+  });
+  expect(z.encode(object.default(value, { skipEncoding: { mode: "strict" } }), value)).toEqual(value);
+  expect(z.encode(z.unknown().default(value, { skipEncoding: { mode: "strict" } }), value)).toBeUndefined();
+  expect(z.encode(z.nan().default(Number.NaN), Number.NaN)).toBeUndefined();
+  expect(z.encode(z.number().default(0), -0)).toBe(-0);
+});
+
+test("skipEncoding deep collection equality", () => {
+  const sparse: (number | undefined)[] = Array(2);
+  sparse[1] = 1;
+  const defaultValue = {
+    sparse,
+    map: new Map<{ id: number }, Set<number>>([
+      [{ id: 1 }, new Set([1, 2])],
+      [{ id: 2 }, new Set([3])],
+    ]),
+  };
+  const schema = z.object({
+    sparse: z.array(z.number().optional()),
+    map: z.map(z.object({ id: z.number() }), z.set(z.number())),
+  });
+  const reordered = {
+    map: new Map<{ id: number }, Set<number>>([
+      [{ id: 2 }, new Set([3])],
+      [{ id: 1 }, new Set([2, 1])],
+    ]),
+    sparse: [undefined, 1],
+  };
+
+  expect(z.encode(schema.default(defaultValue), reordered)).toBeUndefined();
+});
+
+test("skipEncoding omissions propagate through structures", () => {
+  const item = z.string().default("x");
+
+  expect(z.encode(z.array(item), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([item, z.string(), item]), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.record(z.string(), item), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), item),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
