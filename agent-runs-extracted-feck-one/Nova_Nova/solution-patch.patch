+test("encoding omits values equal to encoded static defaults", () => {
+  const schema = z.object({
+    value: z.string().default("default"),
+    other: z.number().default(1, { skipEncoding: false }),
+  });
+
+  expect(z.encode(schema, { value: "default", other: 1 })).toEqual({ other: 1 });
+  expect(z.encode(schema, { value: "changed", other: 1 })).toEqual({ value: "changed", other: 1 });
+  expect(z.encode(schema, { value: "default", other: 2 })).toEqual({ other: 2 });
+  expect(z.encode(schema, { value: "default", other: 1 }, { jitless: true })).toEqual({ other: 1 });
+});
+
+test("encoding compares the encoded child value", () => {
+  const stringNumber = z.codec(z.string(), z.number(), {
+    decode: Number,
+    encode: String,
+  });
+  const schema = z.object({ value: stringNumber.default(42) });
+
+  expect(z.encode(schema, { value: 42 })).toEqual({});
+  expect(z.encode(schema, { value: 43 })).toEqual({ value: "43" });
+});
+
+test("skipEncoding modes compare containers as specified", () => {
+  const deep = z.object({
+    value: z.any().default({ first: { value: 1 }, second: 2 }),
+  });
+  expect(z.encode(deep, { value: { second: 2, first: { value: 1 } } })).toEqual({});
+
+  const shallowDefault = { nested: { value: 1 } };
+  const shallow = z.object({ value: z.any().default(shallowDefault, { mode: "shallow" }) });
+  expect(z.encode(shallow, { value: { nested: { value: 1 } } })).toEqual({
+    value: { nested: { value: 1 } },
+  });
+  expect(z.encode(shallow, { value: { nested: shallowDefault.nested } })).toEqual({});
+
+  const strict = z.object({ value: z.any().default({ value: 1 }, { mode: "strict" }) });
+  expect(z.encode(strict, { value: { value: 1 } })).toEqual({ value: { value: 1 } });
+
+  const set = new Set([{ value: 1 }, { value: 2 }]);
+  const map = new Map([
+    [{ value: 1 }, { value: 2 }],
+    [{ value: 3 }, { value: 4 }],
+  ]);
+  const unordered = z.object({
+    set: z.set(z.object({ value: z.number() })).default(set),
+    map: z.map(z.object({ value: z.number() }), z.object({ value: z.number() })).default(map),
+  });
+  expect(
+    z.encode(unordered, {
+      set: new Set([{ value: 2 }, { value: 1 }]),
+      map: new Map([
+        [{ value: 3 }, { value: 4 }],
+        [{ value: 1 }, { value: 2 }],
+      ]),
+    })
+  ).toEqual({});
+
+  const sparse = z.object({ value: z.any().default([undefined]) });
+  const sparseValue = Array(1);
+  expect(z.encode(sparse, { value: sparseValue })).toEqual({});
+});
+
+test("omitted values are removed from containers and wrappers", () => {
+  const schema = z.object({
+    tuple: z.tuple([z.string().default("first"), z.string(), z.string().default("last")]),
+    record: z.record(z.string(), z.string().default("default")),
+    map: z.map(z.string(), z.string().default("default")),
+    wrapped: z.string().default("wrapped").optional().readonly(),
+  });
+
+  const result = z.encode(schema, {
+    tuple: ["first", "middle", "last"],
+    record: { omitted: "default", kept: "value" },
