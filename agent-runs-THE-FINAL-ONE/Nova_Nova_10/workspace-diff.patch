+#!/bin/bash
+set -euo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+# Parse arguments
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "Unknown argument: $1"
+      shift
+      ;;
+  esac
+done
+
+if [[ -z "$MODE" ]]; then
+  echo "Usage: ./test.sh [--output_path <path>] {base|new}"
+  exit 1
+fi
+
+if [[ "$MODE" == "base" ]]; then
+  # The base repo does not have the new skipEncoding types.
+  # Temporarily move the new test file so Vitest's typechecker doesn't fail on it.
+  mv packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.spec.ts /tmp/encode-defaults.8a4f9b.spec.ts.bak || true
+
+  EXIT_CODE=0
+  if [[ -n "$OUTPUT_PATH" ]]; then
+    pnpm vitest run packages/zod/src/v4/classic/tests/default.test.ts --typecheck.enabled=false --reporter=default --reporter=junit "--outputFile.junit=$OUTPUT_PATH" || EXIT_CODE=$?
+  else
+    pnpm vitest run packages/zod/src/v4/classic/tests/default.test.ts --typecheck.enabled=false || EXIT_CODE=$?
+  fi
+
+  # Restore the test file so new mode can run it!
+  mv /tmp/encode-defaults.8a4f9b.spec.ts.bak packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.spec.ts || true
+
+  exit $EXIT_CODE
+elif [[ "$MODE" == "new" ]]; then
+  if [[ -n "$OUTPUT_PATH" ]]; then
+    pnpm vitest run packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.spec.ts --typecheck.enabled=false --reporter=default --reporter=junit "--outputFile.junit=$OUTPUT_PATH"
+  else
+    pnpm vitest run packages/zod/src/v4/classic/tests/encode-defaults.8a4f9b.spec.ts --typecheck.enabled=false
+  fi
+fi
