+  const strict = z.any().default(strictDefault, { skipEncoding: { mode: "strict" } });
+  expect(z.encode(strict, strictDefault)).toBeUndefined();
+  expect(z.encode(strict, { value: 1 })).toEqual({ value: 1 });
+
+  const sparse = Array(1) as undefined[];
+  expect(z.encode(z.array(z.undefined()).default(sparse), [undefined])).toBeUndefined();
+});
+
