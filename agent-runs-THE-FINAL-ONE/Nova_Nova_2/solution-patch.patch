+
+test("skipEncoding compares fully encoded static defaults", () => {
+  const numberString = z.codec(z.string(), z.number(), {
+    decode: Number,
+    encode: String,
+  });
+  const schema = z.object({ value: numberString.default(12, { skipEncoding: true }) });
+
+  expect(z.encode(schema, { value: 12 })).toEqual({});
+  expect(z.encode(schema, { value: 13 })).toEqual({ value: "13" });
+  expect(z.encode(z.string().default("x", { skipEncoding: true }), "x")).toBeUndefined();
+  expect(z.encode(z.string().default("x"), "x")).toBe("x");
+});
+
+test("skipEncoding comparison modes", () => {
+  const sparse = Array(2);
+  sparse[1] = 1;
+  const deep = z.any().default(
+    {
+      array: sparse,
+      object: { a: 1, b: { c: 2 } },
+      map: new Map<any, any>([[{ id: 1 }, { value: 2 }]]),
+      set: new Set<any>([{ id: 1 }, 2]),
+    },
+    { skipEncoding: true }
+  );
+  expect(
+    z.encode(deep, {
+      set: new Set<any>([2, { id: 1 }]),
+      map: new Map<any, any>([[{ id: 1 }, { value: 2 }]]),
+      object: { b: { c: 2 }, a: 1 },
+      array: [undefined, 1],
+    })
+  ).toBeUndefined();
+
+  const member = { nested: true };
+  expect(z.encode(z.any().default({ member }, { skipEncoding: { mode: "shallow" } }), { member })).toBeUndefined();
+  expect(
+    z.encode(z.any().default({ member }, { skipEncoding: { mode: "shallow" } }), { member: { nested: true } })
+  ).toEqual({ member: { nested: true } });
+  expect(z.encode(z.string().default("x", { skipEncoding: { mode: "strict" } }), "x")).toBeUndefined();
+  expect(z.encode(z.any().default({}, { skipEncoding: { mode: "strict" } }), {})).toEqual({});
+  const sameReference = {};
+  expect(z.encode(z.any().default(sameReference, { skipEncoding: { mode: "strict" } }), sameReference)).toBeUndefined();
+});
+
+test("skipEncoding propagates through structures and wrappers", () => {
+  const omitted = z.string().default("x", { skipEncoding: true });
+
+  expect(z.encode(z.array(omitted), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.tuple([omitted, z.string(), omitted]), ["x", "y", "x"])).toEqual(["y"]);
+  expect(z.encode(z.record(z.string(), omitted), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), omitted),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.encode(z.set(omitted), new Set(["x", "y"]))).toEqual(new Set(["y"]));
+
+  const transparent = z
+    .object({
+      optional: omitted.optional(),
+      union: z.union([omitted, z.number()]),
+      intersection: z.intersection(omitted, z.string()),
+      lazy: z.lazy(() => omitted),
+      pipe: omitted.pipe(z.string()),
+      nonoptional: omitted.nonoptional(),
+    })
+    .loose();
+  expect(
+    z.encode(transparent, {
+      optional: "x",
+      union: "x",
+      intersection: "x",
+      lazy: "x",
+      pipe: "x",
+      nonoptional: "x",
+      extra: true,
+    })
+  ).toEqual({ extra: true });
+});
+
+test("skipEncoding predicates and factory defaults", async () => {
+  const calls: unknown[][] = [];
+  const schema = z.object({
+    value: z.string().default("raw", {
+      skipEncoding: (encoded, raw) => {
+        calls.push([encoded, raw]);
+        return encoded === "encoded";
+      },
+    }),
+  });
+  expect(z.encode(schema, { value: "encoded" })).toEqual({});
+  expect(calls).toEqual([["encoded", "raw"]]);
+
+  const factory = z.string().default(() => "factory", {
+    skipEncoding: (encoded, raw) => encoded === "factory" && raw === undefined,
+  });
+  expect(z.encode(factory, "factory")).toBeUndefined();
+  expect(() => z.string().default(() => "factory", { skipEncoding: true })).toThrow(
+    "Cannot use skipEncoding: true with a factory default"
