+
+  const asyncOmitted = z.string().default("x", { skipEncoding: async () => true });
+  await expect(z.encodeAsync(asyncOmitted, "x")).resolves.toBeUndefined();
+  await expect(z.encodeAsync(z.tuple([asyncOmitted, z.string()]), ["x", "y"])).resolves.toEqual(["y"]);
+  await expect(
+    z.encodeAsync(z.object({ value: z.union([asyncOmitted, z.number()]) }), { value: "x" })
