+    schema.encode({
+      date: new Date(1000),
+      arr: [1, 2],
+      obj: { x: 1 },
+      prim: Number.NaN,
+      prim2: -0,
+    })
+  ).toEqual({});
+});
+
+test("sparse hole equivalence", () => {
