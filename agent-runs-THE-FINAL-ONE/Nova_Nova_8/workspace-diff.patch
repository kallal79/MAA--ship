+  arr1[2] = 1;
+  const schema = z.object({
+    a: z.any().default(arr1, { skipEncoding: true }),
+  });
+  expect(schema.encode({ a: [undefined, undefined, 1] })).toEqual({});
+});
+
+test("implicit default option behaves identically to skipEncoding: true", () => {
