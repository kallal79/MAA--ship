+
+test("skipEncoding comparison modes", () => {
+  const deep = z.object({ value: z.any() }).default({ value: { count: 1 } }, { skipEncoding: true });
+  expect(z.encode(z.object({ deep }), { deep: { value: { count: 1 } } })).toEqual({});
+
+  const shared = { count: 1 };
+  const shallow = z.object({ value: z.any() }).default({ value: shared }, { skipEncoding: { mode: "shallow" } });
+  expect(z.encode(z.object({ shallow }), { shallow: { value: shared } })).toEqual({});
+  expect(z.encode(z.object({ shallow }), { shallow: { value: { count: 1 } } })).toEqual({
+    shallow: { value: { count: 1 } },
+  });
+
+  expect(z.encode(z.nan().default(Number.NaN, { skipEncoding: { mode: "strict" } }), Number.NaN)).toBeUndefined();
+  expect(z.encode(z.number().default(-0, { skipEncoding: true }), 0)).toBe(0);
+
+  const keyOrder = z.any().default({ a: 1, b: 2 }, { skipEncoding: true });
+  expect(z.encode(keyOrder, { b: 2, a: 1 })).toBeUndefined();
+});
+
+test("skipEncoding compares encoded defaults", () => {
+  const date = z
+    .codec(z.string(), z.date(), {
+      decode: (value) => new Date(value),
+      encode: (value) => value.toISOString(),
+    })
+    .default(new Date("2020-01-01T00:00:00.000Z"), { skipEncoding: true });
+  expect(z.encode(date, new Date("2020-01-01T00:00:00.000Z"))).toBeUndefined();
+});
+
+test("skipEncoding deep collections", () => {
+  const sparse = Array(1) as (string | undefined)[];
+  const array = z.array(z.string().optional()).default(sparse, { skipEncoding: true });
+  expect(z.encode(array, [undefined])).toBeUndefined();
+
+  const map = z.map(z.object({ key: z.number() }), z.set(z.number())).default(
+    new Map([
+      [{ key: 1 }, new Set([1, 2])],
+      [{ key: 2 }, new Set([3, 4])],
+    ]),
+    { skipEncoding: true }
+  );
+  expect(
+    z.encode(
+      map,
+      new Map([
+        [{ key: 2 }, new Set([4, 3])],
+        [{ key: 1 }, new Set([2, 1])],
+      ])
+    )
+  ).toBeUndefined();
+});
+
+test("skipEncoding propagates through containers", () => {
+  const skipped = z.string().default("x", { skipEncoding: true });
+  expect(z.encode(z.array(skipped), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.tuple([z.string(), skipped, z.string()]), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.record(z.string(), skipped), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), skipped),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.encode(z.object({ value: z.lazy(() => z.union([skipped, z.number()])) }), { value: "x" })).toEqual({});
+  expect(z.encode(z.object({ value: skipped.and(z.string()) }), { value: "x" })).toEqual({});
+});
+
+test("skipEncoding predicates", async () => {
+  const rawDefault = { value: 1 };
+  let rootCalls = 0;
+  const schema = z.object({ value: z.number() }).default(rawDefault, {
+    skipEncoding(encoded, raw) {
+      rootCalls++;
+      expect(raw).toBe(rawDefault);
+      return (encoded as { value: number }).value === 1;
+    },
+  });
+  expect(z.encode(schema, { value: 1 })).toBeUndefined();
+  expect(rootCalls).toBe(1);
+
+  const factory = z.string().default(() => "x", {
+    skipEncoding(encoded, raw) {
+      expect(raw).toBeUndefined();
+      return encoded === "x";
+    },
+  });
+  expect(z.encode(factory, "x")).toBeUndefined();
+  expect(() => z.string().default(() => "x", { skipEncoding: true } as any)).toThrow(
+    "Cannot use skipEncoding: true with a factory default"
+  );
+
+  const asyncSkipped = z.string().default("x", { skipEncoding: async () => true });
+  expect(() => z.encode(z.object({ value: asyncSkipped }), { value: "x" })).toThrow(
+    "Cannot use async skipEncoding in synchronous encode"
+  );
+  await expect(z.encodeAsync(asyncSkipped, "x")).resolves.toBeUndefined();
+});
