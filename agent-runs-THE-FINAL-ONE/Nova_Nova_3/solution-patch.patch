+    map: new Map<any, any>([[{ id: 1 }, { value: 2 }]]),
+    set: new Set<any>([{ id: 1 }, { id: 2 }]),
+  };
+  const equalValue = {
+    set: new Set<any>([{ id: 2 }, { id: 1 }]),
