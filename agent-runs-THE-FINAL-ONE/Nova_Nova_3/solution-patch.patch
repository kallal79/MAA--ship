+  const schema = z.object({ value: z.any().default(defaultValue, { skipEncoding: true }) });
+
+  expect(z.encode(schema, { value: equalValue })).toEqual({});
+  expect(z.encode(schema, { value: { ...equalValue, set: new Set([{ id: 3 }, { id: 1 }]) } })).toHaveProperty("value");
+
+  const circularDefault: any = {};
+  circularDefault.self = circularDefault;
+  const circularValue: any = {};
+  circularValue.self = circularValue;
+  expect(
+    z.encode(z.object({ value: z.any().default(circularDefault, { skipEncoding: true }) }), { value: circularValue })
+  ).toEqual({});
+});
+
+test("skipEncoding comparison modes", () => {
+  const nested = { value: 1 };
+  const defaultValue = { nested };
+  const shallow = z.object({ value: z.any().default(defaultValue, { skipEncoding: { mode: "shallow" } }) });
+  const strict = z.object({ value: z.any().default(defaultValue, { skipEncoding: { mode: "strict" } }) });
+
+  expect(z.encode(shallow, { value: { nested } })).toEqual({});
+  expect(z.encode(shallow, { value: { nested: { value: 1 } } })).toHaveProperty("value");
+  expect(z.encode(strict, { value: defaultValue })).toEqual({});
+  expect(z.encode(strict, { value: { nested } })).toHaveProperty("value");
+});
