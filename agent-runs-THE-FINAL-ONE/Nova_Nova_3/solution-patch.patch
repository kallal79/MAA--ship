+
+  expect(z.encode(z.array(omitted), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.tuple([z.string(), omitted, z.string()]), ["a", "x", "b"])).toEqual(["a", "b"]);
