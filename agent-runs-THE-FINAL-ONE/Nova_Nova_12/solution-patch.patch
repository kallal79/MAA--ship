+  });
+  expect(() => z.encode(asyncSchema, { value: "x" })).toThrow("Cannot use async skipEncoding in synchronous encode");
+  await expect(z.encodeAsync(asyncSchema, { value: "x" })).resolves.toEqual({});
+});
