+
+test("skipEncoding omits encoded static defaults", () => {
+  const schema = z.object({
+    implicit: z.string().default("x"),
+    disabled: z.string().default("x", { skipEncoding: false }),
+    transformed: z
+      .codec(z.string(), z.number(), {
+        decode: Number,
+        encode: String,
+      })
+      .default(1),
+  });
+
+  expect(z.encode(schema, { implicit: "x", disabled: "x", transformed: 1 })).toEqual({ disabled: "x" });
+  expect(z.encode(schema, { implicit: "y", disabled: "x", transformed: 2 })).toEqual({
+    implicit: "y",
+    disabled: "x",
+    transformed: "2",
+  });
+});
+
+test("skipEncoding comparison modes", () => {
+  const nested = { value: 1 };
+  const value = { nested };
+  const deep = z.any().default(value, { skipEncoding: { mode: "deep" } });
+  const shallow = z.any().default(value, { skipEncoding: { mode: "shallow" } });
+  const strict = z.any().default(value, { skipEncoding: { mode: "strict" } });
+
+  expect(z.encode(deep, { nested: { value: 1 } })).toBeUndefined();
+  expect(z.encode(shallow, { nested })).toBeUndefined();
+  expect(z.encode(shallow, { nested: { value: 1 } })).toEqual({ nested: { value: 1 } });
+  expect(z.encode(strict, value)).toBe(value);
+  expect(z.encode(z.nan().default(Number.NaN, { skipEncoding: { mode: "strict" } }), Number.NaN)).toBeUndefined();
+});
+
+test("deep skipEncoding comparison", () => {
+  const sparse = Array(2);
+  sparse[1] = { a: 1 };
+  const defaultValue = {
+    array: sparse,
+    map: new Map<any, any>([[{ id: 1 }, new Set([{ value: 2 }])]]),
+  };
+  const schema = z.any().default(defaultValue);
+  const reordered = {
+    map: new Map<any, any>([[{ id: 1 }, new Set([{ value: 2 }])]]),
+    array: [undefined, { a: 1 }],
+  };
+
+  expect(z.encode(schema, reordered)).toBeUndefined();
+  expect(z.encode(schema, { ...reordered, array: [undefined, { a: 2 }] })).toEqual({
+    ...reordered,
+    array: [undefined, { a: 2 }],
+  });
+});
+
+test("skipEncoding omission propagates through containers", () => {
+  const item = z.string().default("x");
+  expect(z.encode(z.array(item), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.tuple([z.string(), item, z.string()]), ["a", "x", "b"])).toEqual(["a", "b"]);
+  expect(z.encode(z.record(z.string(), item), { a: "x", b: "y" })).toEqual({ b: "y" });
+  expect(
+    z.encode(
+      z.map(z.string(), item),
+      new Map([
+        ["a", "x"],
+        ["b", "y"],
+      ])
+    )
+  ).toEqual(new Map([["b", "y"]]));
+  expect(z.encode(z.set(item), new Set(["x", "y"]))).toEqual(new Set(["y"]));
+});
+
+test("skipEncoding omission is transparent through schemas", () => {
+  const item = z.string().default("x");
+  const schema = z.object({
+    optional: item.optional(),
+    union: z.union([item, z.string()]),
+    intersection: z.intersection(item, z.string()),
+    lazy: z.lazy(() => item),
+  });
+
+  expect(z.encode(schema, { optional: "x", union: "x", intersection: "x", lazy: "x" })).toEqual({});
+  expect(z.encode(z.object({}).catchall(item), { extra: "x", kept: "y" })).toEqual({ kept: "y" });
+});
+
+test("skipEncoding predicates and factory defaults", async () => {
+  const seen: unknown[][] = [];
+  const rawObject = { value: 1 };
+  const staticSchema = z.string().default("raw", {
+    skipEncoding: (encoded, raw) => {
+      seen.push([encoded, raw]);
+      return encoded === raw;
+    },
+  });
+  const factorySchema = z.string().default(() => "factory", {
+    skipEncoding: (encoded, raw) => {
+      seen.push([encoded, raw]);
+      return encoded === "factory";
+    },
+  });
+  const objectSchema = z.any().default(rawObject, {
+    skipEncoding: (_, raw) => raw === rawObject,
+  });
+
+  expect(z.encode(staticSchema, "raw")).toBeUndefined();
+  expect(z.encode(factorySchema, "factory")).toBeUndefined();
+  expect(z.encode(objectSchema, rawObject)).toBeUndefined();
+  expect(seen).toEqual([
+    ["raw", "raw"],
+    ["factory", undefined],
+  ]);
+  expect(() => z.string().default(() => "x", { skipEncoding: true })).toThrow(
