+test("chained defaulted schemas evaluate skipEncoding independently", () => {
+  const inner = z.number().default(0, { skipEncoding: true });
+  const schema = z.object({
+    a: inner.default(5, { skipEncoding: true }),
+  });
+  // Input 0 -> inner encodes to 0 (and flags skip). Outer receives 0, compares to 5 -> unequal -> clears skip flag!
+  expect(schema.encode({ a: 0 })).toEqual({ a: 0 });
+  // Input 5 -> inner encodes to 5 (no skip). Outer receives 5, compares to 5 -> equal -> sets skip flag!
+  expect(schema.encode({ a: 5 })).toEqual({});
+  // Input 1 -> neither skips
+  expect(schema.encode({ a: 1 })).toEqual({ a: 1 });
+});
