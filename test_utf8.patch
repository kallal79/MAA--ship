+test("shallow equality mode", () => {
+  const obj = { x: 1 };
+  const schema = z.object({
+    o: z.object({ x: z.number() }).default(obj, { skipEncoding: { mode: "shallow" } }),
+  });
+  // Shallow mode compares each top-level property with Object.is
+  // Same reference -> same members -> omit
+  expect(schema.encode({ o: obj })).toEqual({});
+  // Distinct instance with same primitive members -> member-wise Object.is passes -> omit
+  expect(schema.encode({ o: { x: 1 } })).toEqual({});
+  // Different primitive value -> retain
+  expect(schema.encode({ o: { x: 2 } })).toEqual({ o: { x: 2 } });
