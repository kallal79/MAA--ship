+  const level3 = z.object({ inner: level2 }).default({ inner: { n: 0 } }, { skipEncoding: true });
+  const schema = z.object({ outer: level3 });
+  expect(schema.encode({ outer: { inner: { n: 0 } } })).toEqual({});
+  expect(schema.encode({ outer: { inner: { n: 1 } } })).toEqual({ outer: { inner: { n: 1 } } });
