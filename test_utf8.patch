+import { z } from "../../classic";
+
+export function typeTests() {
+  // Test valid string default with true/false skipEncoding
+  z.string().default("test", { skipEncoding: true });
+  z.string().default("test", { skipEncoding: false });
+
+  // Test valid deep/shallow mode
+  z.string().default("test", { skipEncoding: { mode: "deep" } });
+  z.string().default("test", { skipEncoding: { mode: "shallow" } });
+  z.string().default("test", { skipEncoding: { mode: "strict" } });
+
+  // Test valid predicate function
+  z.string().default("test", { skipEncoding: (v) => v === "skip" });
+
+  // Test valid async predicate function
+  z.string().default("test", { skipEncoding: async (v) => v === "skip" });
+
+  // TypeScript should enforce that mode must be exactly "deep" | "shallow" | "strict"
+  // @ts-expect-error
+  z.string().default("test", { skipEncoding: { mode: "invalid" } });
+
+  // Test factory defaults: they only allow predicate functions
+  z.string().default(() => "test", { skipEncoding: (v) => v === "test" });
+
+  // @ts-expect-error - factory default cannot use boolean skipEncoding
+  z.string().default(() => "test", { skipEncoding: true });
+
+  // @ts-expect-error - factory default cannot use object skipEncoding
+  z.string().default(() => "test", { skipEncoding: { mode: "deep" } });
+}
