+test("Map deep equality with object keys", () => {
+  const defaultMap = new Map<object, number>();
+  defaultMap.set({ k: "key" }, 42);
+  const schema = z.object({
+    m: z.map(z.object({ k: z.string() }), z.number()).default(defaultMap, { skipEncoding: true }),
+  });
+  const input = new Map<object, number>();
+  input.set({ k: "key" }, 42);
+  expect(schema.encode({ m: input })).toEqual({});
+  const input2 = new Map<object, number>();
+  input2.set({ k: "other" }, 42);
+  expect(schema.encode({ m: input2 })).not.toEqual({});
+});
